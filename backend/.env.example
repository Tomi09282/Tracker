NODE_ENV=development
PORT=3000
# Number of trusted reverse-proxy hops (1 behind nginx/caddy). MUST stay 0 when the server is
# directly exposed, or clients can spoof X-Forwarded-For and bypass the per-IP rate limits.
TRUST_PROXY=0

# Display name. The UI reads this through /api/v1/config — never hardcode it in the frontend.
APP_NAME=Tracker

DB_PATH=./data/app.db
# Master secret for database encryption — 32+ random chars. Generate with the command below.
DB_MASTER_KEY=CHANGE_ME
# Per-database salt for key derivation, 16+ chars. Changing it makes an existing DB unopenable
# without the rekey procedure (scripts/rekey.js).
DB_KEY_SALT=CHANGE_ME

# 32 random bytes, base64url — signs the access JWTs.
JWT_SECRET=CHANGE_ME
# Key id, for rotation. Bump to k2, k3 … when rotating.
JWT_KID=k1
# Set BOTH of these only while rotating, and remove them 15 minutes later (one access-token
# lifetime). Setting just one of the pair fails validation at boot, on purpose.
# JWT_SECRET_PREV=
# JWT_KID_PREV=
JWT_ISSUER=tracker
JWT_AUDIENCE=tracker-app

LOG_LEVEL=info
# DB worker threads per process. Leave unset in single-process mode (defaults to cores-1).
# Set to 2 when running cluster.js.
# DB_POOL_THREADS=2

# Comma-separated exact origins. Leave EMPTY in development: Vite proxies /api, so the app is
# same-origin and the cookies behave exactly as they will in production.
CORS_ALLOWED_ORIGINS=

# Generate secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

# Stripe webhook SIGNING secret (starts with whsec_), from the Stripe dashboard.
# Optional: the product boots without it, but the webhook endpoint refuses every event.
STRIPE_WEBHOOK_SECRET=whsec_replace_me_with_the_signing_secret
