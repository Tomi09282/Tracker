{
  "about": "S-compose-profile - the frame data of compose-profile-1 / -2 and the undrawn states of the Edzői profil szerkesztő (/compose/profile, URL only on a phone, owner answer Q5; PLAN 4.1 rule 7). Account C (coach@, the seeded profile of Kovács Péter). The profile has no sandbox twin: every capture is a replay of the recording, nothing is written live. Clicks that would write (Mentés, the public switch, Név módosítása) are never pressed except where a state answers the request with a fixture in the browser.",
  "overrides": {
    "compose-profile-1": {
      "why": "the frame script as it is, with its arrived clause by key so the en / de captures arrive too",
      "arrived": {
        "role": "textbox",
        "name": {
          "key": "compose.displayName"
        }
      }
    },
    "compose-profile-2": {
      "why": "the frame script as it is (open the identity line, type the new handle), by key so the en / de captures arrive too; the availability probe GET /compose/handle?handle=kovacs-peter-edzo is recorded",
      "opened": {
        "role": "textbox",
        "name": {
          "key": "compose.displayName"
        }
      },
      "steps": [
        {
          "click": {
            "role": "button",
            "name": {
              "re": "^@kovacs-peter"
            }
          },
          "arrived": {
            "role": "textbox",
            "name": {
              "key": "compose.handle"
            }
          }
        },
        {
          "type": {
            "role": "textbox",
            "name": {
              "key": "compose.handle"
            },
            "text": "kovacs-peter-edzo"
          },
          "arrived": {
            "role": "textbox",
            "name": {
              "key": "compose.handle"
            }
          }
        },
        {
          "advance": 800,
          "arrived": {
            "text": {
              "key": "compose.handleFree"
            }
          }
        }
      ],
      "arrived": {
        "text": {
          "key": "compose.handleFree"
        }
      }
    }
  },
