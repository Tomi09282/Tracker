node_modules/
dist/
build/

# secrets — never committed
.env
.env.*
!.env.example

# runtime data (encrypted DB, WAL/SHM sidecars) and logs
backend/data/
backend/logs/
backend/storage/
backend/seed/cache/

# Backups. Encrypted, and still never committed: a repository is copied, cloned, mirrored and
# pushed to places the database never goes, and "it is encrypted" is one leaked .env away from
# being a full copy of every user's training history and measurements. The first backup this repo
# ever took showed up as an untracked 6.8 MB file one `git add -A` away from the history.
backend/backups/

# tooling noise
.DS_Store
Thumbs.db
*.local
coverage/
.vite/

# graphify — the three OUTPUTS are committed; the working state is not.
#
# `.graphify_python` holds an absolute interpreter path from whichever machine built the graph,
# and the cache/manifest are per-machine incremental state. Committing them would put one
# developer's filesystem into everybody else's checkout and make `--update` reason about files
# that are not there.
graphify-out/*
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md
